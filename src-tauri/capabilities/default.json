{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "opener:allow-open-url",
    "deep-link:default"
  ]
}